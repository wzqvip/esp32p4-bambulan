menu "拓竹屏配置 (Bambu screen)"

    config BBL_WIFI_SSID
        string "Wi-Fi SSID"
        default ""

    config BBL_WIFI_PASSWORD
        string "Wi-Fi 密码"
        default ""

    config BBL_TIMEZONE
        string "时区 (POSIX TZ)"
        default "CST-8"
        help
            用于显示时钟和预计完成时间。中国用 CST-8。

    config BBL_TLS_VERIFY
        bool "校验打印机 TLS 证书 (BBL CA + 序列号)"
        default y
        help
            打开时用内置的拓竹 CA 证书校验打印机，并把证书 CN 与序列号比对。
            如果连接一直报 TLS 错误，可以先关掉试试。

    config BBL_PRINTER_COUNT
        int "打印机数量"
        range 1 2
        default 2

    menu "打印机 1"
        config BBL_P1_NAME
            string "显示名称"
            default "A1 #1"
        config BBL_P1_HOST
            string "IP 地址"
            default ""
        config BBL_P1_SERIAL
            string "序列号 (SN)"
            default ""
        config BBL_P1_ACCESS_CODE
            string "局域网访问码"
            default ""
    endmenu

    menu "打印机 2"
        depends on BBL_PRINTER_COUNT >= 2
        config BBL_P2_NAME
            string "显示名称"
            default "A1 #2"
        config BBL_P2_HOST
            string "IP 地址"
            default ""
        config BBL_P2_SERIAL
            string "序列号 (SN)"
            default ""
        config BBL_P2_ACCESS_CODE
            string "局域网访问码"
            default ""
    endmenu

    config BBL_LCD_SWAP_BYTES
        bool "RGB565 交换字节（屏幕颜色不对时再打开）"
        default n

    config BBL_BACKLIGHT_PERCENT
        int "屏幕亮度 (%)"
        range 5 100
        default 100

    choice BBL_DISP_MODE
        prompt "屏幕刷新方式"
        default BBL_DISP_PARTIAL_1FB
        help
            实测（V1.0 板）：2 块帧缓冲 + vsync 切换时整屏亮度有可见闪烁（约 ±3%），
            局部渲染 + 1 块帧缓冲（官方例程的方式）不闪，也没有看到撕裂。
        config BBL_DISP_PARTIAL_1FB
            bool "局部渲染 + 1 块帧缓冲（与 ELECROW 官方例程相同，推荐）"
        config BBL_DISP_DIRECT_2FB
            bool "直接渲染到 2 块帧缓冲，vsync 切换（这块屏上会闪）"
    endchoice

    menu "调试 (Debug)"
        config BBL_PAGE_ANIM_MS
            int "切页动画时长 (ms，0 = 直接切换)"
            range 0 1000
            default 0
            help
                滑动动画每帧都要整屏重画（实测约 35~50ms 一帧，只有 18~23fps），
                所以默认直接切换（一帧，约 40~60ms）。想要滑动效果可以设成 200。

        config BBL_DEBUG_PERF
            bool "串口打印渲染耗时和帧率"
            default n
            help
                每 5 秒打印一次平时的渲染统计；每次切页动画结束后打印这次动画的
                帧数、帧率、每帧渲染/等待刷新耗时。

        config BBL_DEBUG_PAGE_CYCLE
            bool "自动在总览和详情页之间来回切换（每 3 秒）"
            default n

        config BBL_DEBUG_NO_CAMERA
            bool "不连接摄像头（排查闪烁用）"
            default n

        config BBL_DEBUG_CAMERA_MODE
            int "摄像头调试模式：0 正常，1 只收不解码，2 解码但不上屏"
            range 0 2
            default 0
            depends on !BBL_DEBUG_NO_CAMERA
            help
                排查闪烁用：分别对应 Wi-Fi 收流 / 硬件 JPEG+PPA / LVGL 重画 三段负载。
    endmenu

endmenu
